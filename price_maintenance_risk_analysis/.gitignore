# 数据文件（运行时生成）
data/*.json
data/images_temp/

# ML 训练用特征矩阵(大文件, 可由 DB + export_features/derive_features 重建)
# 冻结快照存 DB(ml_dataset_snapshot 表)作为版本库, 不入 git 避免每次重训 10MB churn
# schema 文档(features_schema.md)仍跟踪
ml_training/data/features.csv
ml_training/data/features.parquet
ml_training/data/features_derived.csv
ml_training/data/features_derived.parquet

# 回测产物(panel/universe/样本清单, 大文件, 由脚本重建)
ml_training/data/backtest_samples.parquet
ml_training/data/backtest_universe*.xlsx
ml_training/data/features_backtest.parquet
ml_training/data/universe*.parquet
ml_training/data/namechange.parquet
ml_training/data/*.bak_pre_pit*
# 毯式: ml_training/data 下所有 parquet 都是生成产物(DB+脚本可重建), 不入 git
# 含 features_backtest_{1500,4103,fullA}*、pilot_*、samples_*、sue_timelines 等
ml_training/data/*.parquet
# panel BLOB 落库前的受管目录(若启用) + 阈值缓存
ml_training/data/.panels/
ml_training/data/threshold_cache.json

# 回测输出 csv
ml_training/output/backtest_ls_*.csv

# 包根 output/(backfill_early/logs 临时产物)
/output/

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
venv/
env/
ENV/

# IDE配置
.vscode/
.idea/
*.swp
*.swo
*~

# 报告输出
reports/outputs/*.docx

# 策略屏幕输出(运行时生成)
strategies/output/

# 本地密钥(token 不进 git; 代码经 tushare_token.resolve_tushare_token() 读取)
.tushare_token

# 临时文件
*.log
*.tmp
.DS_Store

# ML 训练/评估产物(可由 DB + 脚本重建, 不入 git)
# 模型权重+元信息存 DB(ml_model_meta); 仅 model_registry.json(版本索引) 仍跟踪
ml_training/output/v_*/
ml_training/output/per_horizon_features/
ml_training/output/loyo_*.csv
ml_training/output/horizon_*.csv
ml_training/output/horizon_summary_all.csv
ml_training/output/gray_zone*.csv
ml_training/output/*_compare.csv
ml_training/output/old_scorecard*.csv
ml_training/output/frozen_scorecard*.csv
ml_training/data/placements_*.xlsx
